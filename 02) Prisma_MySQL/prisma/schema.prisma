

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model user {
  id  Int @id @default(autoincrement())
  email String @unique
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  
}